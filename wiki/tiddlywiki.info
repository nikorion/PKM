{
  "description": "pkm suite integration wiki",
  "plugins": [
    "tiddlywiki/filesystem",
    "tiddlywiki/tiddlyweb",
    "nikorion/pkm-schema",
    "nikorion/pkm-fields",
    "nikorion/dyntable",
    "nikorion/table",
    "nikorion/math",
    "nikorion/chart",
    "nikorion/font-manager",
    "nikorion/hover-tilt",
    "nikorion/plugin-info-tree",
    "nikorion/scroll-layout",
    "nikorion/tiny-bootstrap",
    "tiddlywiki/highlight",
    "tiddlywiki/katex",
    "nikorion/detect-language"
  ],
  "themes": [
    "tiddlywiki/vanilla"
  ],
  "languages": [
    "fr-FR"
  ],
  "config": {
    "retain-original-tiddler-path": true
  },
  "build": {
    "html": [
      "--output",
      "docs",
      "--rendertiddler",
      "$:/core/save/all",
      "PKM-Wiki.html",
      "text/plain",
      "",
      "publishFilter",
      "-[[$:/config/SyncFilter]] -[[$:/config/FileSystemPaths]] -[[$:/config/OriginalTiddlerPaths]] -[[$:/plugins/kookma/commander]]"
    ]
  }
}
